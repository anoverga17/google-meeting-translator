{
  "manifest_version": 3,
  "name": "Meet Caption Capture",
  "version": "0.1.0",
  "description": "Streams Google Meet live captions to a local transcript server.",
  "content_scripts": [{ "matches": ["https://meet.google.com/*"], "js": ["content.js"] }],
  "background": { "service_worker": "background.js" },
  "action": {},
  "host_permissions": ["http://localhost:8765/*"]
}
